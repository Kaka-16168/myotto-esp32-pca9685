{
    "type": "otto-robot",
    "target": "esp32s3",
    "builds": [
        {
            "name": "otto-robot",
            "sdkconfig_append": [
                "CONFIG_HTTPD_WS_SUPPORT=y",
                "CONFIG_SPIRAM=y",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_SPIRAM_SPEED_80M=y",
                "CONFIG_SPI_MASTER_ISR_IN_IRAM=y"
            ]
        }
    ]
}
